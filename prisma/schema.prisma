generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model analyses {
  id                  String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_id          String           @db.Uuid
  status              String           @default("completed")
  created_at          DateTime?        @default(now()) @db.Timestamptz(6)
  analysis_type       String?
  analysis_timestamp  DateTime?        @db.Timestamptz(6)
  boundary_normalized Json?
  north_direction     Float?
  report_paid         Boolean          @default(false)
  projects            projects         @relation(fields: [project_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  analysis_items      analysis_items[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model analysis_items {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  analysis_id String    @db.Uuid
  object      String
  direction   String
  confidence  Float?    @db.Real
  source      String
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  analyses    analyses  @relation(fields: [analysis_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model map_plots {
  id                                              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_id                                      String?    @db.Uuid
  storage_path                                    String
  is_active                                       Boolean    @default(true)
  created_at                                      DateTime   @default(now()) @db.Timestamptz(6)
  projects_map_plots_project_idToprojects         projects?  @relation("map_plots_project_idToprojects", fields: [project_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  projects_projects_active_map_plot_idTomap_plots projects[] @relation("projects_active_map_plot_idTomap_plots")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model profiles {
  id                      String                    @id @db.Uuid
  email                   String?
  role                    String                    @default("user")
  created_at              DateTime?                 @default(now()) @db.Timestamptz(6)
  valid_from              DateTime?                 @db.Timestamptz(6)
  valid_to                DateTime?                 @db.Timestamptz(6)
  expert_code             String?                   @unique
  is_expert_pending       Boolean                   @default(false)
  referred_by_expert_id   String?                   @db.Uuid
  astrologer_applications astrologer_applications[]
  assigned_projects       projects[]                @relation("ProjectToAstrologer")
  projects                projects[]
  referred_users          profiles[]                @relation("ExpertReferral")
  referred_by_expert      profiles?                 @relation("ExpertReferral", fields: [referred_by_expert_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model project_objects {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_id          String    @db.Uuid
  object_type         String
  boundary_normalized Json
  centroid            Json
  marma_distance      Float?
  issues              Json?
  created_at          DateTime? @default(now()) @db.Timestamptz(6)
  projects            projects  @relation(fields: [project_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model projects {
  id                                               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                                          String            @db.Uuid
  name                                             String
  boundary_normalized                              Json?
  north_direction                                  Float?            @default(0)
  created_at                                       DateTime?         @default(now()) @db.Timestamptz(6)
  creator_name                                     String?
  report_for                                       String?
  status                                           String            @default("active")
  deleted_at                                       DateTime?         @db.Timestamptz(6)
  completed_at                                     DateTime?         @db.Timestamptz(6)
  archived_at                                      DateTime?         @db.Timestamptz(6)
  active_map_plot_id                               String?           @db.Uuid
  plot_width                                       Float?
  plot_height                                      Float?
  plot_diagonal                                    Float?
  plot_side_back                                   Float?
  plot_side_front                                  Float?
  plot_side_left                                   Float?
  plot_side_right                                  Float?
  has_right_angle                                  Boolean?
  right_angle_corner                              String?
  assigned_astrologer_id                           String?           @db.Uuid
  expert_id                                        String?           @db.Uuid
  metadata                                         Json?
  video_path                                       String?
  analyses                                         analyses[]
  map_plots_map_plots_project_idToprojects         map_plots[]       @relation("map_plots_project_idToprojects")
  project_objects                                  project_objects[]
  map_plots_projects_active_map_plot_idTomap_plots map_plots?        @relation("projects_active_map_plot_idTomap_plots", fields: [active_map_plot_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  astrologer                                       profiles?         @relation("ProjectToAstrologer", fields: [assigned_astrologer_id], references: [id], onUpdate: NoAction)
  profiles                                         profiles          @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model user_credits {
  user_id    String    @id @db.Uuid
  credits    Int       @default(0)
  updated_at DateTime? @default(now()) @db.Timestamptz(6)
}

model astrologer_keys {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key           String    @unique
  duration_days Int
  is_claimed    Boolean   @default(false)
  claimed_by    String?   @db.Uuid
  claimed_at    DateTime? @db.Timestamptz(6)
  created_at    DateTime? @default(now()) @db.Timestamptz(6)
}

model astrologer_applications {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String    @db.Uuid
  status      String    @default("PENDING")
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  reviewed_at DateTime? @db.Timestamptz(6)
  profiles    profiles  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

enum color_type {
  WALL
  OBJECT
  FLOOR
}

enum object_type {
  BED
  SOFA
  TABLE
  STAIRCASE
  BEAM
  COLUMN
  MIRROR
  AQUARIUM
  BAR
  KITCHEN_SLAB
  STOVE
  SINK
  TOILET
  WASHBASIN
}
